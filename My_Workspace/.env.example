BUNDU_ENV=development
BUNDU_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
BUNDU_MANAGER_REGISTRATION_KEY=replace-with-a-random-initial-manager-bootstrap-key
BUNDU_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
BUNDU_RATE_LIMIT_STORAGE_URI=memory://
BUNDU_PUBLIC_URL=http://127.0.0.1:5000
BUNDU_FRONTEND_URL=http://127.0.0.1:5500
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=ZAR
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-mailbox@example.com
SMTP_PASSWORD=your-provider-app-password
SMTP_FROM=DineDesk Customer Care <your-mailbox@example.com>
SMTP_USE_SSL=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
